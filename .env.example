# KnowVault-Core — Variables de entorno

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=KnowVault-Core
POSTGRES_USER=KnowVault-Core
POSTGRES_PASSWORD=changeme

# Cadena de conexion (usando nombre del servicio Docker Compose)
ConnectionStrings__Default=Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# URL base para el cliente Electron
KnowVault-Core_API_BASE_URL=http://localhost:8080

# URL base para el frontend web (Nginx)
KnowVault-Core_WEB_URL=http://localhost:3000

