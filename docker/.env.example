# ── KnowVault-Core Environment ──────────────────────────────────
# Copy this file to .env and adjust values for your environment.

# ASP.NET Core environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL connection string (overrides appsettings)
ConnectionStrings__Default=Host=postgres;Database=KnowVault-Core;Username=KnowVault-Core;Password=changeme

# PostgreSQL container settings
POSTGRES_DB=KnowVault-Core
POSTGRES_USER=KnowVault-Core
POSTGRES_PASSWORD=changeme

# ── API Keys ────────────────────────────────────────────────────
# Maps X-Api-Key header values to usernames for audit trail identity.
# Format: ApiKeys__<key-value>=<username>
# Multiple keys can be defined; one per line.
ApiKeys__kv-admin-001=admin
ApiKeys__kv-editor-001=editor
